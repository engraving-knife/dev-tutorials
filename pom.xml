<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven 构建配置
  设计意图：
  1. 编译目标锁定 Java 11，与运行环境保持一致；
  2. 不引入任何第三方依赖，仅使用 JDK 自带能力（内置 HttpServer + WatchService），
     使得打包产物为一个可独立运行的 fat jar，可直接部署到云服务器；
  3. 通过 maven-shade-plugin 将启动类信息写入 MANIFEST，支持 java -jar 一键启动。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>html-monitor</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>html-monitor</name>
    <description>HTML 目录实时监控与网页展示服务</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <build>
        <!-- 打包后的 jar 文件名 -->
        <finalName>html-monitor</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
            <!-- 打 fat jar：把所有 class 与资源合并进一个可执行 jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.example.htmlmonitor.HtmlMonitorApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
